# Trail's cards are gitignored but should stay greppable: ripgrep reads
# .ignore before .gitignore, so this re-admits the tree to search only.
!.trail/
!.trail/cache/
.trail/cache/.cache/
.trail/cache/.graph/

# graft's cards are gitignored but should stay greppable: ripgrep reads
# .ignore before .gitignore, so this re-admits the tree to search only.
!.context/
.context/.cache/
.context/.graph/
